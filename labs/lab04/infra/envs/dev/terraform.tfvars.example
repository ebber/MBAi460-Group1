aws_region  = "us-east-2"
# Default lab operator profile (see ../../../claude-workspace/aws-env.sh).
# Override with ErikTheWizard after: aws sso login --profile ErikTheWizard
aws_profile = "Claude-Conjurer"

api_stage_name = "prod"

# terraform output -raw lab_project_permissions_boundary_arn
# (from infra/bootstrap/plane2-iam-delegation)
lab_project_permissions_boundary_arn = "arn:aws:iam::772360735396:policy/LabProjectPermissionsBoundary"

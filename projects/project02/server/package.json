{
  "name": "project02-server",
  "version": "0.1.0",
  "private": true,
  "description": "Project 02 Part 01 web server — self-contained split MVP with local PhotoApp core. Spec-compliant /v1 routes (Gradescope 60/60) + engineering /v2 surface (Phase 4). Layered architecture: route → controller → local service → repository.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --passWithNoTests",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration --passWithNoTests",
    "test:contract": "jest tests/contract --passWithNoTests",
    "test:smoke": "jest tests/smoke --passWithNoTests",
    "test:happy": "jest tests/happy_path --passWithNoTests",
    "test:live": "PHOTOAPP_RUN_LIVE_TESTS=1 jest tests/live --passWithNoTests",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write ."
  },
  "license": "ISC",
  "engines": {
    "node": ">=24.x",
    "npm": ">=11.x"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "3.1045.0",
    "@aws-sdk/client-s3": "3.1045.0",
    "@aws-sdk/credential-providers": "3.1045.0",
    "express": "^5.2.1",
    "ini": "^6.0.0",
    "multer": "^2.1.1",
    "mysql2": "3.22.3",
    "opossum": "9.0.0",
    "p-retry": "8.0.0",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "uuid": "^9.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^17.6.0",
    "jest": "^30.3.0",
    "js-yaml": "3.14.2",
    "lint-staged": "^16.2.4",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2"
  }
}
